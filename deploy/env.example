# Save as a private .env file; do not commit the populated file.
PB_DOMAIN=pb.example.com
PB_ORIGIN=https://pb.example.com
PB_DB_PASSWORD=replace-with-a-unique-random-password
PB_ASSETS_DIR=/srv/pb/assets
PB_BIND_HOST=127.0.0.1
PB_HTTP_PORT=18800
# Supply one TURN option before an internet playtest. TURN is separate from the HTTP proxy.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=
# Or short-lived Cloudflare TURN credentials generated by the backend:
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
